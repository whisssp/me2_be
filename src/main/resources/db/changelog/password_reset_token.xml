<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!-- Define changeset -->
    <changeSet id="create-table-password_reset_token" author="gwen">
        <createTable tableName="password_reset_token">
            <column name="id" type="serial8" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="reset_code" type="varchar(5)">
                <constraints nullable="false" />
            </column>
            <column name="expiration" type="timestamp">
                <constraints nullable="false" />
            </column>

        </createTable>
        <addForeignKeyConstraint
                baseTableName="password_reset_token"
                baseColumnNames="user_id"
                constraintName="fk_user_id_reset_password"
                referencedTableName="password_reset_token"
                referencedColumnNames="id"
        />
    </changeSet>
    <changeSet author="gwen"  id="update_foreignKey_in_table_password_reset_token">
        <dropForeignKeyConstraint
                baseTableName="password_reset_token"
                constraintName="fk_user_id_reset_password"
        />
        <addForeignKeyConstraint
                baseTableName="password_reset_token"
                baseColumnNames="user_id"
                constraintName="fk_user_id_reset_password"
                referencedTableName="users"
                referencedColumnNames="id"
        />
    </changeSet>

</databaseChangeLog>